$MEM-GC

pub sct Person {
    cstr name.
    csi32 age.
}

pub enm Colour {
    Red.
    Green.
    Blue.
}

pub err DatabaseError {
    cstr message.
    csi32 code.
}

pub fc add(csi32 a, csi32 b = 5)!csi32 {
    exit a + b.
}

fc test(csi32 start, csi32 end)!void {

    val csi32 x = 10.
    val csi32 y = -5.
    val cbln flag = true.
    val cstr name = "Simar".
    val csi32[] numbers = [1, 2, 3, 4].

    x += 5.
    x *= 2.
    x /= 3.

    val csi32 z = (x + y) * 2.

    if (x > y && flag) {

        x = add(x, y).

    }
    elif (x == y) {

        x = 0.

    }
    else {

        x = 100.

    }

    while (x > 0) {
        x -= 1.
    }

    for (item : numbers) {
        exit 1.
    }

    val csi32 converted = x >> csi32.

    exit 1.
}